FROM alpine:3.22

RUN apk add --no-cache iproute2 iputils nftables wireguard-tools

COPY gateway-entrypoint.sh /usr/local/sbin/gateway-entrypoint
RUN sed -i 's/\r$//' /usr/local/sbin/gateway-entrypoint && chmod 0755 /usr/local/sbin/gateway-entrypoint

ENTRYPOINT ["/usr/local/sbin/gateway-entrypoint"]
