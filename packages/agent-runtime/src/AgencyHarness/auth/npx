#!/bin/sh
set -eu

case "${1:-}" in
    artifacts-npm-credprovider|@microsoft/artifacts-npm-credprovider)
        shift
        exec artifacts-npm-credprovider "$@"
        ;;
esac

directory=$PWD
while :; do
    config="$directory/.npmrc"
    if [ -f "$config" ] && grep -Eiq 'pkgs\.(dev\.azure\.com|visualstudio\.com)' "$config"; then
        artifacts-npm-credprovider --config-file "$config" --verbosity error
        break
    fi
    [ "$directory" = "/" ] && break
    directory=$(dirname "$directory")
done

exec npx-real "$@"
